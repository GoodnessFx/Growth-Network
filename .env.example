# ─── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
DATABASE_URL=./data/growth-network.db

# ─── WhatsApp Cloud API ──────────────────────────────
# Required: you MUST complete Meta Business Verification first.
# Walkthrough: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=   # From Meta Developer Console → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=      # Permanent token from Meta Developer Console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=growth-network-webhook-verify-2024
WHATSAPP_BUSINESS_ACCOUNT_ID= # WABA ID from Meta Business Manager
WHATSAPP_SENDER_NUMBER=08072027335

# ─── Meta Ads / Instagram / Facebook Graph API ──────
# Required: Meta App (https://developers.facebook.com)
# Scopes needed: ads_read, ads_management, pages_read_engagement, instagram_basic, pages_show_list
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=          # Long-lived Page/User token
META_AD_ACCOUNT_ID=         # act_XXXXXXXXX from Meta Ads Manager
META_WEBHOOK_SECRET=

# ─── Google Ads API ──────────────────────────────────
# Required: Google Ads developer token (https://developers.google.com/google-ads/api/docs/first-call/dev-token)
# Also need OAuth 2.0 client credentials for a Google Ads manager account
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID= # 10-digit MCC ID without dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # Optional, if using MCC

# ─── TikTok Ads API ──────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_ID=
TIKTOK_ADVERTISER_ID=

# ─── X (Twitter) API ─────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ─── YouTube Data API ────────────────────────────────
YOUTUBE_API_KEY=

# ─── LinkedIn API ────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ─── Payment Gateways ────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── Website Tracking ────────────────────────────────
TRACKING_API_SECRET=change-this-to-a-random-secret
TRACKING_ALLOWED_ORIGINS=buy-smart.com.ng,opes.ng,hamdanglobal.com.ng

# ─── Database ────────────────────────────────────────
DB_PATH=./data/growth-network.db
