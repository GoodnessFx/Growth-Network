# ─── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
DATABASE_URL=./data/growth-network.db
DB_PATH=./data/growth-network.db

# ─── OAuth model (Phase 4) ───────────────────────────
# Most platforms are now connected per-business via OAuth. Register an app on
# each platform's developer console, then set the client ID/secret + the
# redirect URI below. The server callback exchanges the code for a token and
# stores it in the social_connections table for the logged-in business.
#
#   Callback base: http://localhost:3001/api/oauth/callback/:platform
#   (Use your deployed origin in production.)
#
# The LONG-LIVED TOKEN variables further down are kept as a single-tenant
# FALLBACK only — when a business has no connection row for a platform, the
# server falls back to these. They are not required for per-business OAuth.

# ─── WhatsApp Cloud API ──────────────────────────────
# Required: you MUST complete Meta Business Verification first.
# Walkthrough: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=   # From Meta Developer Console → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=      # Permanent token from Meta Developer Console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=growth-network-webhook-verify-2024
WHATSAPP_BUSINESS_ACCOUNT_ID= # WABA ID from Meta Business Manager
WHATSAPP_SENDER_NUMBER=08072027335

# ─── Meta (Facebook, Instagram, WhatsApp, Meta Ads) ──
# App: https://developers.facebook.com
# Scopes: ads_read, ads_management, pages_read_engagement, instagram_basic,
#         pages_show_list, pages_manage_posts, business_management
META_CLIENT_ID=
META_CLIENT_SECRET=
META_APP_ID=                # Same value as client ID for long-lived token fallback
META_APP_SECRET=
META_ACCESS_TOKEN=          # FALLBACK: long-lived Page/User token
META_AD_ACCOUNT_ID=         # FALLBACK: act_XXXXXXXXX from Meta Ads Manager
META_WEBHOOK_SECRET=

# ─── Google (YouTube, Google Ads, Search Console, Business Profile) ──
# ONE OAuth app covers all four — enable these scopes in Google Cloud Console:
#   youtube.upload, youtube.readonly, https://www.googleapis.com/auth/adwords,
#   https://www.googleapis.com/auth/webmasters.readonly,
#   https://www.googleapis.com/auth/business.manage
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=  # Required for Google Ads API (apply at the Ads API center)
GOOGLE_ADS_MANAGER_CUSTOMER_ID= # FALLBACK: 10-digit MCC ID without dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # Optional, if using MCC
GOOGLE_SEARCH_CONSOLE_SITE_URL= # FALLBACK: e.g. sc-domain:example.com or https://example.com/
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID= # FALLBACK: account number for the business profile
GOOGLE_ADS_REFRESH_TOKEN=    # FALLBACK: long-lived refresh token
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN= # FALLBACK: long-lived access token
GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN= # FALLBACK: long-lived access token
YOUTUBE_ACCESS_TOKEN=        # FALLBACK: OAuth access token for uploads
YOUTUBE_API_KEY=             # Read-only Data API key (metrics)

# ─── TikTok (organic + TikTok Ads) ──────────────────
# App: https://developers.tiktok.com
# Scopes: video.upload, video.publish, advertising.read
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=         # FALLBACK: long-lived access token
TIKTOK_APP_ID=
TIKTOK_ADVERTISER_ID=        # FALLBACK: advertiser ID from TikTok Ads Manager

# ─── X (Twitter) ─────────────────────────────────────
# App: https://developer.x.com
# OAuth 2.0 scopes: tweet.read, tweet.write, users.read, offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=              # FALLBACK: OAuth2 bearer token
X_API_KEY=                   # Legacy v1.1 keys (not used by OAuth 2.0 flow)
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ─── LinkedIn ────────────────────────────────────────
# App: https://developer.linkedin.com
# Scopes: r_liteprofile, w_member_social, rw_ads, r_ads_reporting
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=       # FALLBACK: long-lived access token

# ─── Snapchat ────────────────────────────────────────
# Marketing API: https://developers.snap.com (application + approval required)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_ACCESS_TOKEN=       # FALLBACK: Marketing API access token
SNAPCHAT_ADVERTISER_ID=      # FALLBACK: ad account ID

# ─── Pinterest ───────────────────────────────────────
# App: https://developers.pinterest.com
# Scopes: boards:read, pins:read, pins:write, user_accounts:read
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=      # FALLBACK: long-lived access token
PINTEREST_BOARD_ID=          # FALLBACK: default board ID

# ─── Threads ─────────────────────────────────────────
# App: https://developers.facebook.com (Threads product)
# Scopes: threads_basic, threads_content_publish, threads_read_replies
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=        # FALLBACK: access token
THREADS_USER_ID=             # FALLBACK: Threads user ID

# ─── Payment Gateways ────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── Security & Website Tracking ────────────────────
# CORS whitelist for the API (comma-separated). localhost dev origins are always allowed.
ALLOWED_ORIGINS=
# Origins allowed to call the tracking ingest endpoint (comma-separated).
TRACKING_ALLOWED_ORIGINS=buy-smart.com.ng,opes.ng,hamdanglobal.com.ng
# Shared secret embedded in generated tracking snippets; POST /api/tracking/event
# rejects requests without it. If unset, a random secret is generated at boot.
TRACKING_SECRET=change-this-to-a-random-secret
